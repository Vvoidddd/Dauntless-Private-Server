# Local development defaults. Copy to .env; never commit real secrets.
DPS_HOST=127.0.0.1
DPS_PORT=8000
DPS_DATABASE_PATH=data/server.db
DPS_SESSION_TTL_SECONDS=86400

# Optional owner-controlled PlayFab title integration.
# The integration remains disabled unless both values are set.
DPS_PLAYFAB_TITLE_ID=YOUR_TITLE_ID
DPS_PLAYFAB_SECRET_KEY=LOAD_FROM_A_SECRET_STORE
DPS_PLAYFAB_TIMEOUT_SECONDS=5
